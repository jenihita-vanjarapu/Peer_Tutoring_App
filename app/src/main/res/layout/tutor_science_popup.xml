<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/popup_rounded_bg"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="Please select what classes you want to teach"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2">

        <CheckBox
            android:id="@+id/cb_biology"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Biology" />

        <CheckBox
            android:id="@+id/cb_ap_physics2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AP Physics 2" />

        <CheckBox
            android:id="@+id/cb_chemistry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chemistry" />

        <CheckBox
            android:id="@+id/cb_ap_physics_c"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AP Physics C" />

        <CheckBox
            android:id="@+id/cb_physics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Physics" />

        <CheckBox
            android:id="@+id/cb_ap_chem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AP Chemistry" />

        <CheckBox
            android:id="@+id/cb_ap_physics1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AP Physics 1" />

        <CheckBox
            android:id="@+id/cb_ap_bio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AP Biology" />

        <CheckBox
            android:id="@+id/cb_ap_research"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AP Research" />

        <CheckBox
            android:id="@+id/cb_ap_sem_science"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AP Seminar" />

        <CheckBox
            android:id="@+id/cb_ap_psych"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AP Psychology" />
    </GridLayout>

    <Button
        android:id="@+id/btnSaveScience"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#243E56"
        android:text="Save Science" />
</LinearLayout>