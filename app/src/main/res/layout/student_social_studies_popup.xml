<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/student_popup_rounded_bg"
    android:orientation="vertical"
    android:padding="20dp"
    android:elevation="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Social Studies_StudentFrame\nPlease select what classes you struggle with:"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2">

        <CheckBox android:id="@+id/cb_world_history" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="World History" />
        <CheckBox android:id="@+id/cb_ap_human_geo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AP Human Geo" />
        <CheckBox android:id="@+id/cb_us_history1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="US History 1" />
        <CheckBox android:id="@+id/cb_ap_us_history" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AP US History" />
        <CheckBox android:id="@+id/cb_us_history2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="US History 2" />
        <CheckBox android:id="@+id/cb_ap_us_gov" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AP US Gov" />
    </GridLayout>

    <Button
        android:id="@+id/btnSaveSocialStudies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Save Social Studies"
        android:backgroundTint="#8A5A5A"/>
</LinearLayout>