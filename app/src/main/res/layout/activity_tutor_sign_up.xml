<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F5F0"
    android:padding="25dp"
    tools:context=".Tutor_Sign_Up">

    <TextView
        android:paddingTop="20dp"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tutor Sign Up"
        android:textColor="#000000"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEmail"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:boxStrokeColor="#2C3E50"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        app:hintTextColor="#2C3E50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:startIconDrawable="@android:drawable/ic_menu_myplaces">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/Tutor_SignUp_Email"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPassword"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_marginTop="12dp"
        app:boxStrokeColor="#2C3E50"
        app:hintTextColor="#2C3E50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilEmail"
        app:passwordToggleEnabled="true"
        app:startIconDrawable="@android:drawable/ic_lock_lock">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/Tutor_SignUp_Password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_marginTop="12dp"
        app:boxStrokeColor="#2C3E50"
        app:hintTextColor="#2C3E50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilPassword"
        app:startIconDrawable="@android:drawable/ic_menu_myplaces">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/Tutor_SignUp_Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRecommendation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#243E56"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="Teacher Recommendation"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:cornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilName" />

    <TextView
        android:id="@+id/tvQuestionSubjects"
        android:layout_width="326dp"
        android:layout_height="28dp"
        android:layout_marginTop="20dp"
        android:text="What subjects can you tutor in?"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.216"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnRecommendation" />

    <CheckBox
        android:id="@+id/Tutor_ELA_Selection"
        android:layout_width="177dp"
        android:layout_height="58dp"
        android:layout_marginTop="12dp"
        android:buttonTint="#7F97A9"
        android:paddingLeft="15dp"
        android:text="ELA"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/Tutor_Social_Studies_Selection"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvQuestionSubjects" />


    <CheckBox
        android:id="@+id/Tutor_Social_Studies_Selection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:buttonTint="#7F97A9"
        android:text="Social Studies"
        android:textSize="16sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/Tutor_ELA_Selection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/Tutor_ELA_Selection" />


    <CheckBox
        android:id="@+id/Tutor_Math_Selection"
        android:layout_width="0dp"
        android:paddingLeft="15dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:buttonTint="#7F97A9"
        android:text="Math"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/Tutor_Science_Selection"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Tutor_ELA_Selection" />


    <CheckBox
        android:id="@+id/Tutor_Science_Selection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:buttonTint="#7F97A9"
        android:text="Science"
        android:textSize="16sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/Tutor_Math_Selection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/Tutor_Math_Selection" />


    <TextView
        android:id="@+id/QuestionDates"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="180dp"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:text="What dates are you available for?"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRecommendation" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/Tutor_SignUP_Choose_Btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:backgroundTint="#243E56"
        android:text="Choose"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:cornerRadius="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/QuestionDates" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/Tutor_SignUP_Login_Btn"
        android:layout_width="285dp"
        android:layout_height="51dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#243E56"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:text="Login"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Tutor_SignUP_Choose_Btn"
        app:layout_constraintVertical_bias="0.78" />


</androidx.constraintlayout.widget.ConstraintLayout>
